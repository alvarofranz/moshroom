//
//  template_setup.xcconfig
//     --> copied to developer_setup.xcconfig
//

// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

// Replace with your own 10-character Apple Developer Team ID.
TEAM_ID = YOUR_TEAM_ID

// BUNDLE_ID is used as name for BUNDLE_IDENTIFIER
BUNDLE_ID = com.example.moshroom
GROUP_ID  = com.example.moshroom

// CLOUD_ID is used as name for iCloud (prefix icloud. is added)
CLOUD_ID = com.example.moshroom
// if you want to build without iCloud, please remove the section in xCode

// KEYCHAIN_ID is used as name for keychain
KEYCHAIN_ID1 = com.example.moshroom
// if you want to build without keychain, please remove the section in xCode

MOSHROOM_APP_FONT = JetBrains Mono

// --- Build compatibility flags for modern Xcode (15+/16+/26) ---

// Export the executable's global symbols so dlsym(RTLD_MAIN_ONLY, ...) can resolve
// the built-in command entry points (help_main, moshroom_ssh_main, ...). Required
// with the newer linker.
MOSHROOM_OTHER_LDFLAGS = -Xlinker -export_dynamic

// Xcode 16+ wraps the app code in a "debug dylib" (Moshroom.debug.dylib) and leaves a
// thin launcher as the main executable. That breaks dlsym(RTLD_MAIN_ONLY, *_main),
// because the command symbols end up in the dylib instead of the main executable.
// Disabling it links everything into the main executable so dlsym finds them again.
ENABLE_DEBUG_DYLIB = NO
