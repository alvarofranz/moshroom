<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ios_system SEEDS its internal command registry from a file with EXACTLY this name in the app
  bundle: initializeCommandList() loads commandDictionary.plist from [NSBundle mainBundle], and
  if the file is missing it returns EARLY with a nil commandList - which silently turns the
  addCommandList(moshroomCommandsDictionary.plist) call at launch into a NO-OP, so every
  ios_system-dispatched command (ssh, config, clear, help...) prints "command not found".
  (Deleting this file on 2026-07-07 broke exactly that; mosh kept working because MCPSession
  dispatches it natively.) This file is a byte-identical copy of moshroomCommandsDictionary.plist,
  the canonical Moshroom registry - keep them in sync.
-->
<plist version="1.0">
<dict>
	<key>clear</key>
	<array>
		<string>MAIN</string>
		<string>clear_main</string>
		<string></string>
		<string>no</string>
	</array>
	<key>config</key>
	<array>
		<string>MAIN</string>
		<string>config_main</string>
		<string></string>
		<string>no</string>
	</array>
	<key>help</key>
	<array>
		<string>MAIN</string>
		<string>help_main</string>
		<string></string>
		<string>no</string>
	</array>
	<key>history</key>
	<array>
		<string>MAIN</string>
		<string>history_main</string>
		<string>c</string>
		<string>no</string>
	</array>
	<key>mosh1</key>
	<array>
		<string>MAIN</string>
		<string>mosh_main</string>
		<string></string>
		<string>no</string>
	</array>
	<key>scp</key>
	<array>
		<string>MAIN</string>
		<string>copyfiles_main</string>
		<string></string>
		<string>no</string>
	</array>
	<key>sftp</key>
	<array>
		<string>MAIN</string>
		<string>copyfiles_main</string>
		<string></string>
		<string>no</string>
	</array>
	<key>ssh</key>
	<array>
		<string>MAIN</string>
		<string>moshroom_ssh_main</string>
		<string>axR:L:Vo:CGp:i:hqTtvl:F:</string>
		<string>no</string>
	</array>
	<key>ssh-add</key>
	<array>
		<string>MAIN</string>
		<string>moshroom_ssh_add</string>
		<string>axR:L:Vo:CGp:i:hqTtvl:F:</string>
		<string>no</string>
	</array>
</dict>
</plist>
